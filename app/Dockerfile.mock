# syntax=docker/dockerfile:1

ARG PYTHON_IMAGE=python:3.13-slim-bookworm
ARG UV_IMAGE=ghcr.io/astral-sh/uv:0.12.5

FROM ${UV_IMAGE} AS uv

FROM ${PYTHON_IMAGE} AS builder

COPY --from=uv /uv /bin/uv

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    UV_PROJECT_ENVIRONMENT=/opt/mock-downstream/venv

RUN --mount=type=cache,target=/root/.cache/uv \
    uv venv /opt/mock-downstream/venv --python 3.13 \
 && uv pip install --python /opt/mock-downstream/venv/bin/python \
    "fastapi==0.135.1" "uvicorn[standard]==0.41.0"


FROM ${PYTHON_IMAGE} AS runtime

ARG GIT_SHA=unknown

LABEL org.opencontainers.image.title="mock-downstream" \
      org.opencontainers.image.description="Mock Pokemon downstream service for local and CI use" \
      org.opencontainers.image.revision="${GIT_SHA}"

ENV PATH=/opt/mock-downstream/venv/bin:$PATH \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app

RUN groupadd --system --gid 10001 mockdownstream \
 && useradd --system --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin mockdownstream \
 && rm -rf /usr/local/lib/python3.13/site-packages/pip /usr/local/lib/python3.13/site-packages/pip-*.dist-info \
    /usr/local/bin/pip /usr/local/bin/pip3 /usr/local/bin/pip3.13

COPY --from=builder /opt/mock-downstream/venv /opt/mock-downstream/venv

WORKDIR /app
COPY mock_service/ mock_service/

USER 10001:10001

EXPOSE 8001

CMD ["uvicorn", "mock_service.main:app", "--host", "0.0.0.0", "--port", "8001"]
